# Copy to .env and fill in before running a public instance.

# CONTACT_EMAIL: An address MET.no and Nominatim can reach you on.
# Both services ask for a contact in the User-Agent and may block traffic
# without one. Required in practice for anything but local development.
CONTACT_EMAIL=""

# APP_URL: Where this instance is hosted. Included in the User-Agent sent
# to external APIs so they can see which application is calling.
APP_URL="https://github.com/barx10/sving"

# PORT: Port the server listens on. Defaults to 3000.
PORT=3000

# OPENROUTESERVICE_API_KEY: Optional but recommended. When set, routing uses
# OpenRouteService, which returns real elevation with the geometry in a single
# call and is far more reliable than the public OSRM demo server.
# Note: ORS has no motorcycle profile, so we use driving-car with motorways and
# toll roads excluded, then rank its alternatives by curvature ourselves.
# Without a key the app falls back to public OSRM plus a separate elevation
# lookup. Free key: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=""

# TRUST_PROXY: Set when running behind a load balancer so per-IP rate limiting
# sees the real client address. Usually "1". Defaults to 1 in production.
TRUST_PROXY=""

# OVERPASS_URL: Where to look up fuel stations and rest areas along a route.
# Defaults to the public overpass-api.de, which is shared with the whole OSM
# world and enforces a per-IP slot limit. A busy instance should point this at
# its own mirror rather than lean harder on the public one.
OVERPASS_URL=""
